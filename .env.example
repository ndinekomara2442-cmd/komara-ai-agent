# Komara AI Agent — Variables d'environnement
# Copie ce fichier en .env et remplace les valeurs

# Telegram Bot
TELEGRAM_BOT_TOKEN_2=your_telegram_bot_token

# Hugging Face (IA conversationnelle — gratuit)
# Get it: https://huggingface.co/settings/tokens
HUGGING_FACE_ACCESS_TOKEN=your_hf_token
HF_TOKEN=your_hf_token

# Twilio WhatsApp (optionnel)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# Serveur
PORT=8000
SERVER_URL=https://your-domain.com
